# ═══════════════════════════════════════════
#   MUC Library — .gitignore
#   Full-Stack: React (client) + Node (server)
# ═══════════════════════════════════════════

# ─── Dependencies ───────────────────────────
node_modules/
client/node_modules/
server/node_modules/
.pnp
.pnp.js

# ─── Environment / Secrets ──────────────────
# NEVER commit .env files — they contain DB credentials, JWT secrets, SMTP passwords
.env
.env.*
!.env.example
client/.env
client/.env.*
server/.env
server/.env.*

# ─── Build Outputs ──────────────────────────
dist/
build/
client/dist/
client/build/
server/dist/
server/build/

# ─── Vite Cache ─────────────────────────────
.vite/
client/.vite/

# ─── TypeScript Cache ───────────────────────
*.tsbuildinfo
client/tsconfig.tsbuildinfo
server/tsconfig.tsbuildinfo

# ─── Uploads (keep folder, ignore content) ──
# Uploaded files (book covers, PDFs, profile pics) should NOT be in git.
# Use a separate file storage service (S3, Cloudinary) for production.
server/uploads/**
!server/uploads/.gitkeep
!server/uploads/books-covers/.gitkeep
!server/uploads/books-pdfs/.gitkeep
!server/uploads/profiles/.gitkeep

# ─── Logs ───────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
logs/
server/logs/

# ─── OS / System Files ──────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── IDEs & Editors ─────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Prisma ─────────────────────────────────
# Keep schema and migrations, ignore generated client (can be regenerated)
server/node_modules/.prisma/

# ─── Testing ────────────────────────────────
coverage/
.nyc_output/

# ─── Misc ───────────────────────────────────
.cache/
.temp/
*.local
